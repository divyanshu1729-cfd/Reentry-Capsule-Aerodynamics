FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 277.78;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 277.78;
    }

    farfield
    {
        type            fixedValue;
        value           uniform 277.78;
    }

    outlet
    {
        type            zeroGradient;
    }

    coneWall
    {
        type            zeroGradient;
    }
   
     noseCap 
    {
        type            zeroGradient;
    }    

    wedgeFront
    {
        type            wedge;
    }

    wedgeBack
    {
        type            wedge;
    }

    axis
    {
        type            empty;
    }
}


FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (1670.565 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (1670.565 0 0);
    }

    farfield
    {
        type            fixedValue;
        value           uniform (1670.565 0 0);
    }

    outlet
    {
        type            zeroGradient;
    }

    coneWall
    {
        type            slip;
    }
    
    noseCap
    {
        type            slip;
    }    

    wedgeFront
    {
        type            wedge;
    }

    wedgeBack
    {
        type            wedge;
    }

    axis
    {
        type            empty;
    }
}


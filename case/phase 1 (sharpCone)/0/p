FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 10000;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 10000;
    }

    farfield
    {
        type            fixedValue;
        value           uniform 10000;
    }

    outlet
    {
        type            zeroGradient;
    }

    coneWall
    {
        type            zeroGradient;
    }
    
    noseCap 
    {
        type            zeroGradient;
    }    

    wedgeFront
    {
        type            wedge;
    }

    wedgeBack
    {
        type            wedge;
    }

    axis
    {
        type            empty;
    }
}


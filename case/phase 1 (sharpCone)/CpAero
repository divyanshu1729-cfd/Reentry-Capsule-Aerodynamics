FoamFile
{
    format      binary;
    class       volScalarField;
    location    "0";
    object      CpAero;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 1433.84;
    }
    farfield
    {
        type            freestreamPressure;
        freestreamValue uniform 1433.84;
        supersonic      true;
        value           uniform 1433.84;
    }
    outlet
    {
        type            zeroGradient;
    }
    noseCap
    {
        type            zeroGradient;
    }
    coneWall
    {
        type            zeroGradient;
    }
    numericalAfterbody
    {
        type            zeroGradient;
    }
    wedgeBack
    {
        type            wedge;
    }
    wedgeFront
    {
        type            wedge;
    }
    axis
    {
        type            empty;
    }
}



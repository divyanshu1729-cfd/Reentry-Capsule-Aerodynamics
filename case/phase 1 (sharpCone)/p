FoamFile
{
    format      ascii;
    class       volScalarField;
    object      p;
}

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 1433.84;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 1433.84;
    }

    farfield
    {
        type            freestreamPressure;
        freestreamValue uniform 1433.84;
        supersonic      true;
    }

    outlet
    {
        type            zeroGradient;
    }

    noseCap
    {
        type            zeroGradient;
    }

    coneWall
    {
        type            zeroGradient;
    }

    numericalAfterbody
    {
        type            zeroGradient;
    }

    wedgeBack
    {
        type            wedge;
    }

    wedgeFront
    {
        type            wedge;
    }

    axis
    {
        type            empty;
    }
}


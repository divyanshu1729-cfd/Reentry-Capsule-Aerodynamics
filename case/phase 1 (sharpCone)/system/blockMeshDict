            (7 16 17 8)
            (16 24 25 17)
        );
    }

    outlet
    {
        type patch;

        faces
        (
            (18 20 21 19)
            (20 22 23 21)
            (22 24 25 23)
        );
    }

    coneWall
    {
        type wall;

        faces
        (
            (10 18 19 11)
        );
    }

    noseCap

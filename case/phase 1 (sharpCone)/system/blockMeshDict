        type wedge;

        faces
        (
            (0 9 10 1)
            (1 10 12 3)
            (3 12 14 5)
            (5 14 16 7)
            (10 18 20 12)
            (12 20 22 14)
            (14 22 24 16)
        );
    }

    wedgeBack
    {
        type wedge;

        faces
        (
            (0 9 11 2)
            (2 11 13 4)
            (4 13 15 6)
            (6 15 17 8)
            (11 19 21 13)
            (13 21 23 15)
            (15 23 25 17)
        );
    }

    axis
    {
        type empty;

        faces
        (
            (0 9 9 0)
        );
    }
);



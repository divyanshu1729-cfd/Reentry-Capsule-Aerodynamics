FoamFile
{
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

// Coordinates below are in millimetres.
convertToMeters 0.001;


// ------------------------------------------------------------------------- //
// 20-degree cone, 5-degree axisymmetric wedge sector
// Regularised nose: flat truncation at x = 5 mm
//
// Streamwise axis: x
// Radial direction: y
// Circumferential direction: z
// Wedge angle: -2.5 deg to +2.5 deg
//
// The downstream cone surface remains on r = x*tan(20 deg).
// At x = 5 mm, r_wall = 1.819851171 mm.
//
// The original collapsed apex has been removed.  The upstream domain is
// partitioned into four regular blocks, and the downstream domain into the
// same three refinement bands used for the sharp-cone case.
// ------------------------------------------------------------------------- //

vertices
(
    // Inlet, x = -1250 mm
    (-1250.000000    0.000000    0.000000)    // 0  axis

    // Auxiliary upstream partition radii: 100, 250, 500, 1250 mm
    (-1250.000000   99.904822   -4.361939)    // 1  r=100 front
    (-1250.000000   99.904822    4.361939)    // 2  r=100 back

    (-1250.000000  249.762055  -10.904847)    // 3  r=250 front
    (-1250.000000  249.762055   10.904847)    // 4  r=250 back

    (-1250.000000  499.524111  -21.809694)    // 5  r=500 front
    (-1250.000000  499.524111   21.809694)    // 6  r=500 back

    (-1250.000000 1248.810277  -54.524234)    // 7  farfield front
    (-1250.000000 1248.810277   54.524234)    // 8  farfield back

    // Truncation plane, x = 5 mm
    (    5.000000    0.000000    0.000000)    // 9  axis

    // Cone wall: r = 5*tan(20 deg) = 1.819851171 mm
    (    5.000000    1.818119   -0.079381)    // 10 wall front
    (    5.000000    1.818119    0.079381)    // 11 wall back

    // Lower refinement interface, r = 5 mm
    (    5.000000    4.995241   -0.218097)    // 12 front
    (    5.000000    4.995241    0.218097)    // 13 back

    // Upper refinement interface, r = 15 mm
    (    5.000000   14.985723   -0.654291)    // 14 front
    (    5.000000   14.985723    0.654291)    // 15 back

    // Farfield at truncation plane
    (    5.000000 1248.810277  -54.524234)    // 16 front
    (    5.000000 1248.810277   54.524234)    // 17 back

    // Outlet, x = 2000 mm
    // 20-degree cone wall
    ( 2000.000000  727.247631  -31.752317)    // 18 wall front
    ( 2000.000000  727.247631   31.752317)    // 19 wall back

    // 23-degree refinement ray
    ( 2000.000000  848.141620  -37.030663)    // 20 front
    ( 2000.000000  848.141620   37.030663)    // 21 back

    // 27-degree refinement ray
    ( 2000.000000 1018.080988  -44.450376)    // 22 front
    ( 2000.000000 1018.080988   44.450376)    // 23 back

    // Farfield
    ( 2000.000000 1248.810277  -54.524234)    // 24 front
    ( 2000.000000 1248.810277   54.524234)    // 25 back
);


blocks
(
    // Upstream axis block. Ends on the flat nose cap.
    hex (0 9 10 1 0 9 11 2)
        (160 16 1)
        simpleGrading (0.125 1 1)

    // Upstream block matched to downstream near-wall band
    hex (1 10 12 3 2 11 13 4)
        (160 64 1)
        simpleGrading (0.125 1 1)

    // Upstream block matched to downstream shock-refinement band
    hex (3 12 14 5 4 13 15 6)
        (160 64 1)
        simpleGrading (0.125 1 1)

    // Upstream outer block
    hex (5 14 16 7 6 15 17 8)
        (160 120 1)
        simpleGrading (0.125 6 1)

    // Downstream near-wall band
    hex (10 18 20 12 11 19 21 13)
        (280 64 1)
        simpleGrading (8 1 1)

    // Downstream shock-refinement band
    hex (12 20 22 14 13 21 23 15)
        (280 64 1)
        simpleGrading (8 1 1)

    // Downstream outer field
    hex (14 22 24 16 15 23 25 17)
        (280 120 1)
        simpleGrading (8 6 1)
);


// Preserve constant-radius circumferential edges.
edges
(
    // Inlet
    arc 1 2   (-1250.000000  100.000000 0.000000)
    arc 3 4   (-1250.000000  250.000000 0.000000)
    arc 5 6   (-1250.000000  500.000000 0.000000)
    arc 7 8   (-1250.000000 1250.000000 0.000000)

    // Truncation plane
    arc 10 11 (5.000000    1.819851171 0.000000)
    arc 12 13 (5.000000    5.000000000 0.000000)
    arc 14 15 (5.000000   15.000000000 0.000000)
    arc 16 17 (5.000000 1250.000000000 0.000000)

    // Outlet
    arc 18 19 (2000.000000  727.940469 0.000000)
    arc 20 21 (2000.000000  848.949632 0.000000)
    arc 22 23 (2000.000000 1019.050899 0.000000)
    arc 24 25 (2000.000000 1250.000000 0.000000)
);


boundary
(
    inlet
    {
        type patch;

        faces
        (
            (0 1 2 0)
            (1 3 4 2)
            (3 5 6 4)
            (5 7 8 6)
        );
    }

    farfield
    {
        type patch;

        faces

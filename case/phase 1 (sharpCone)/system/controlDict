FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// ************************************************************************* //

solver          shockFluid;

// Start this new mesh from its uniform initial fields
startFrom       latestTime;
startTime       0;

stopAt          endTime;

// 500 outer pseudo-time iterations:
// 5e-5 / 1e-7 = 500
endTime         7e-3;
deltaT          1e-7;

// Save every 100 iterations
writeControl    runTime;
writeInterval   5e-5;

purgeWrite      0;

writeFormat     binary;
writePrecision  15;
writeCompression off;

timeFormat      general;
timePrecision   8;

runTimeModifiable true;

// localEuler controls its own cell-local pseudo-time scale
adjustTimeStep  no;


functions
{
    fieldMinimum
    {
        type            volFieldValue;
        libs            ("libfieldFunctionObjects.so");

        log             true;
        writeFields     false;
        writeLocation   true;

        cellZone        all;
        operation       min;

        fields
        (
            rho
            p
            T
        );

        writeControl    timeStep;
        writeInterval   10;
    }


    fieldMaximum
    {
        type            volFieldValue;
        libs            ("libfieldFunctionObjects.so");

        log             true;
        writeFields     false;
        writeLocation   true;

        cellZone        all;
        operation       max;

        fields
        (
            rho
            p
            T
        );

        writeControl    timeStep;
        writeInterval   10;
    }


    velocityMaximum
    {
        type            volFieldValue;
        libs            ("libfieldFunctionObjects.so");

        log             true;
        writeFields     false;
        writeLocation   true;

        cellZone        all;
        operation       maxMag;

        fields
        (
            U
        );

        writeControl    timeStep;
        writeInterval   10;
    }


    conePressureMean
    {
        type            surfaceFieldValue;
        libs            ("libfieldFunctionObjects.so");

        log             true;
        writeFields     false;

        patch           coneWall;
        operation       areaAverage;

        fields
        (
            p
        );

        writeControl    timeStep;
        writeInterval   10;
    }


    conePressureCoV
    {
        type            surfaceFieldValue;
        libs            ("libfieldFunctionObjects.so");

        log             true;
        writeFields     false;

        patch           coneWall;
        operation       CoV;

        fields
        (
            p
        );

        writeControl    timeStep;
        writeInterval   10;
    }
}

// ************************************************************************* //

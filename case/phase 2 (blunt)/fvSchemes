FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}

fluxScheme      Kurganov;

ddtSchemes
{
    default         localEuler;
}

gradSchemes
{
    default         Gauss linear;
}

divSchemes
{
    default         none;
}

laplacianSchemes
{
    default         Gauss linear corrected;
}

interpolationSchemes
{
    default             linear;

    // Preserve positivity while the bow shock and viscous layer are formed.
    // A limited second-order restart is a later, separately verified step.
    reconstruct(rho)    upwind;
    reconstruct(U)      upwind;
    reconstruct(T)      upwind;
}

snGradSchemes
{
    default         corrected;
}

